# Copy this file to .env and fill in real values before running the app.
# Never commit .env — it's already in .gitignore.

# Backend server port
PORT=4000

# Direct Postgres connection string (Supabase project settings → Database → Connection string)
DATABASE_URL=postgresql://user:password@localhost:5432/fitprep

# Supabase project (Project settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Nutrition data provider (e.g. Edamam, Spoonacular, USDA FoodData Central)
NUTRITION_API_KEY=your-nutrition-api-key
